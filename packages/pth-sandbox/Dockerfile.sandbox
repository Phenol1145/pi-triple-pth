# ---- Builder stage ----
FROM node:22-slim AS builder

WORKDIR /app


COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
# npm workspaces（全部 workspace 包的 package.json——workspace 链接必需）
COPY packages/pth-memory/package.json packages/pth-memory/
COPY packages/pth-sandbox/package.json packages/pth-sandbox/
COPY packages/pth-console/package.json packages/pth-console/
ARG NPM_CONFIG_REGISTRY
RUN npm ci

COPY packages/ ./packages/
# 2026-08-21 拆仓：沙箱运行时 = pth-memory + pth-sandbox 两包；
# shared/infra 已是 npm 发布包，不再编译 framework。
RUN npx tsc -p packages/pth-memory \
    && npx tsc -p packages/pth-sandbox

# ---- Runtime stage ----
# sandbox：隔离命令执行容器。安全边界：
#   - P0-2：控制器以容器内 root 运行（仅用于 spawn 时 setuid 到不可信用户）；所有工作负载
#     （/exec、Python/Bash REPL）以 workload（UID/GID 2001）运行，无法读控制器 env/密钥或改写 /app
#   - egress 锁定：compose 仅挂 internal 网络（本镜像不暴露任何出网路径；curl 仅供 healthcheck 内网探测）
#   - 共享密钥经 compose env 注入（SANDBOX_SHARED_SECRET），不镜像硬编码
FROM node:22-slim

# curl（healthcheck）/ bash（exec API 字符串命令）；tmux（调试入口）；git（pi 自修改模式依赖）
# 调试/编译链：gcc/g++（编译核 variants）、gdb（调试 L0）、strace/valgrind（调试 L2 + obs 观测）、
# tcc（变体快编译）
RUN apt-get update && apt-get install -y curl bash tmux git python3 python3-pip gcc g++ gdb strace valgrind tcc && rm -rf /var/lib/apt/lists/*
# kernel sandbox SPEC §3.1：PyKernel 宿主依赖
RUN pip3 install --no-cache-dir numpy --break-system-packages || pip3 install --no-cache-dir numpy

# P0-2：创建不可信工作负载用户；控制器（root）通过 spawn uid/gid 降权运行 workload
RUN groupadd --gid 2001 workload && useradd --system --uid 2001 --gid workload --create-home --shell /bin/bash workload
ENV PTH_WORKLOAD_UID=2001 PTH_WORKLOAD_GID=2001
# P0-3：/exec 先拷贝任务工作区到该私有根（chown workload），执行完回拷并 chown 回 PTH node（1000）
ENV PTH_EXEC_PRIVATE_ROOT=/srv/workload PTH_WORKSPACE_OWNER_UID=1000 PTH_WORKSPACE_OWNER_GID=1000
# P2-6 readiness 需要私有根存在（运行时每次任务子目录仍按需 mkdir/chown）
RUN mkdir -p /srv/workload && chmod 0711 /srv/workload

WORKDIR /app

ENV DATA_DIR=/data

COPY package.json package-lock.json ./
# workspace 包目录（package.json + 构建产物——npm ci 链接必需）
COPY packages/ ./packages/
# build 阶段可联网（npm registry）；运行时内网锁（internal 网络无外部出口）。
# pi 可执行（@earendil-works/pi-coding-agent 的 bin）随 --omit=dev 装入。
ARG NPM_CONFIG_REGISTRY
RUN npm ci --omit=dev

COPY --from=builder /app/packages/pth-memory/dist /app/packages/pth-memory/dist
COPY --from=builder /app/packages/pth-sandbox/dist /app/packages/pth-sandbox/dist

# 内嵌 pi（自修改模式）：/usr/local/bin/pi → node_modules/@earendil-works/pi-coding-agent/dist/cli.js
# 镜像不持 LLM 密钥（用户裁决）：需要自修改会话时按需临时注入 env，用完即撤。
RUN ln -sf /app/node_modules/@earendil-works/pi-coding-agent/dist/cli.js /usr/local/bin/pi && \
    chmod +x /usr/local/bin/pi

# PTL 已拆出（pi-triple-ptl）；sandbox 不再内嵌 ptl/framework——PTL 能力经 pth CLI/HTTP API 到达。

ENV PI_CODING_AGENT_DIR=/data/agent-dir
# PTH 服务名（sandbox-internal 网络）：沙箱回桥 PTH 的固定地址
ENV PLATFORM_URL=http://pi-platform:3000

# 工作区共享卷（compose：workspaces → /data/workspaces，与 pth 同卷同路径）。
# P0-2：workload 用户需要写工作区，暂保持 0777；/app 归 root，workload 只读。
RUN mkdir -p /data/workspaces /data/agent-dir /data/compiled-cache \
    && chmod 0777 /data/workspaces /data/compiled-cache \
    && chown -R root:root /app /data/agent-dir

# 控制器以容器内 root 运行（仅用于 setuid 到 workload；容器无特权模式/无 Docker socket）

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["node", "packages/pth-sandbox/dist/main.js"]
