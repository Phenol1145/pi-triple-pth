# PTH 统一环境文件（密钥 + 宿主本地路径；配置集中化 C3，2026-08-16 / W0 收口）
#
# 使用（推荐）：pth init --workspaces /abs/path/to/workspaces
#   自动把下方 7 个示例密钥替换为 64-hex 强随机值，并写入 PTH_WORKSPACES_HOST。
# 手动复制：cp deploy/.env.pth.secrets.example deploy/.env.pth.secrets
#   docker compose --env-file deploy/.env.pth.secrets -f deploy/docker-compose.yaml up -d
#
# .env.pth.secrets 已在 .gitignore 中——绝不提交真实值。
# 生产要求：上方 5 个核心密钥 :? fail-closed（缺任一 compose 拒绝启动）；LOCAL_EXEC_SHARED_SECRET /
# JUPYTER_SERVICE_TOKEN 为可选注入（engine compose 用 ${VAR:-}，缺失仅影响对应后端）。
# PTH_CONFIG_STRICT=1 会在主进程再次校验（弱密钥/开发默认值直接 fail-fast）。

# sandbox 控制器间认证（pi-platform 与 sandbox 同值）
SANDBOX_SHARED_SECRET=dev-only-change-me-sandbox-secret-0000000000000000

# 执行 grant 签名密钥（pi-platform 与 sandbox 同值；>=32 字符）
PTH_EXECUTION_GRANT_SECRET=dev-only-change-me-grant-secret-000000000000000000000

# 记忆桥 Bearer token（pi-platform 与 sandbox 同值；生产必填）
PTH_MEMORY_BRIDGE_TOKEN=dev-only-change-me-memory-bridge-token-00000000

# postgres / redis（生产必改；URL 由 compose 分字段拼装）
POSTGRES_PASSWORD=dev-only-change-me-pg-password-0000000000000000
REDIS_PASSWORD=dev-only-change-me-redis-password-0000000000000000

# 宿主本地执行器共享密钥（pth services 起 local-lean/local-u8 时注入，engine 同值）
LOCAL_EXEC_SHARED_SECRET=dev-only-change-me-local-exec-secret-0000000000000000

# jupyter 南面 execution/v1.1 共享密钥（pth services up jupyter 与 engine 同值）
JUPYTER_SERVICE_TOKEN=dev-only-change-me-jupyter-service-token-000000000000

# 宿主本地路径（非密钥；compose `:?` 必填，pth init --workspaces 自动写入）
# PTH_WORKSPACES_HOST=/abs/path/to/workspaces
